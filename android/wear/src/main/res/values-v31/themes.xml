<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The system splash stays plain black: the Compose splash (ui/Splash.kt)
      then fades the logo in at the dial's centre, so there is no size jump
      between the system's icon and ours.
    -->
    <style name="PulseTheme" parent="@android:style/Theme.DeviceDefault">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
